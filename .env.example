# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL of the app — used to build links inside emails.
APP_URL=http://localhost:3000

# ── Administrator ──────────────────────────────────────────────
# The ONLY account that receives the admin role (assigned server-side).
ADMIN_EMAIL=harshavardhangowda525@gmail.com

# ── Authentication provider (self-hosted JWT sessions) ─────────
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=mm_session
SESSION_MAX_AGE_DAYS=7
BCRYPT_ROUNDS=12

# ── Database ───────────────────────────────────────────────────
# SQLite file path (created automatically). Swap server/db.js for Postgres if desired.
DATABASE_FILE=./data/mindmap.db

# ── Email service (SMTP) ───────────────────────────────────────
# Leave SMTP_HOST empty in development: emails are logged to the console and
# the verification link is returned in the API response for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Verification email sender (the "From" address shown to users)
EMAIL_FROM=MindMap <no-reply@yourdomain.com>

# ── Token lifetimes ────────────────────────────────────────────
EMAIL_VERIFICATION_EXPIRES_MIN=1440   # 24 hours
PASSWORD_RESET_EXPIRES_MIN=60         # 1 hour
